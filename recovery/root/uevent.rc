# DEVICE; Alps tb8163p3_bsp uevent.mt8163.rc for custom recovery
#
#
parallel_restorecon enabled


# Firmware directory Path
# Below macro will be read by uevent and path will
# be added to search path for firmware loading
firmware_directories /etc/firmware/ /odm/firmware/ /vendor/firmware/ /firmware/image/

parallel_restorecon_dir /sys

subsystem graphics
    devname uevent_devpath
    dirname /dev/graphics

subsystem drm
    devname uevent_devpath
    dirname /dev/dri

subsystem input
    devname uevent_devpath
    dirname /dev/input

subsystem sound
    devname uevent_devpath
    dirname /dev/snd

# ueventd can only set permissions on device nodes and their associated
# sysfs attributes, not on arbitrary paths.
#
# format for /dev rules: devname mode uid gid
# format for /sys rules: nodename attr mode uid gid
# shortcut: "mtd@NN" expands to "/dev/mtd/mtdNN"



# eMMC/Ext4 Common
/dev/block/platform/mtk-msdc.0/11230000.MSDC0/by-name/boot        0640      root      root
/dev/block/platform/mtk-msdc.0/11230000.MSDC0/by-name/dkb         0640      root      root
/dev/block/platform/mtk-msdc.0/11230000.MSDC0/by-name/kb          0640      root      root
/dev/block/platform/mtk-msdc.0/11230000.MSDC0/by-name/logo        0660      root      root
/dev/block/platform/mtk-msdc.0/11230000.MSDC0/by-name/misc2       0660      root      root
/dev/block/platform/mtk-msdc.0/11230000.MSDC0/by-name/recovery    0640      root      root
/dev/block/platform/mtk-msdc.0/11230000.MSDC0/by-name/seccfg      0640      root      root
/dev/block/platform/mtk-msdc.0/11230000.MSDC0/by-name/secro       0640      root      root

# Change partition permission
# eMMC only
/dev/block/mmcblk0                               0660    root    system
/dev/block/mmcblk0boot0                          0660    root    system
/dev/block/mmcblk0boot1                          0660    root    system

# EXT only
/dev/block/sda                                   0660    root    system
/dev/block/sdb                                   0660    root    system
/dev/block/sdc                                   0660    root    system

# Full /dev Directory List
